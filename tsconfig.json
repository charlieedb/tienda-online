{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/catalog/**/*.ts",
    "src/components/Icons.tsx",
    "src/components/ProductCard.tsx",
    "src/components/CartView.tsx",
    "src/components/ProfileView.tsx",
    "src/components/AuthWelcome.tsx",
    "src/auth/AuthProvider.tsx",
    "src/lib/firebase.ts",
    "src/lib/env.ts",
    "src/lib/userProfile.ts",
    "src/store/cart.ts",
    "src/lib/appVersion.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
